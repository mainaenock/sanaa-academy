{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sanaa-academy",
	"compatibility_date": "2026-10-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sanaa-academy",
			"database_id": "b13a39ae-a762-4fae-b000-d5dd3a526b99",
			"migrations_dir": "migrations",
		},
		{
			"binding": "sanaa_academy",
			"database_name": "sanaa-academy",
			"database_id": "b13a39ae-a762-4fae-b000-d5dd3a526b99",
			"remote": true
		},
	],
	"vars": {
		"APP_URL": "http://localhost:5173",
		"APP_ENV": "development",
		"PAYSTACK_MODE": "test",
		"TURNSTILE_HOSTNAMES": "localhost,127.0.0.1",
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		},
	},
	"assets": {
		"directory": "dist/client",
		"html_handling": "none",
		"not_found_handling": "none",
		"binding": "ASSETS",
		"run_worker_first": [
			"/*",
			"!/_next/static/*",
			"!/*/_next/static/*"
		],
	},
}
